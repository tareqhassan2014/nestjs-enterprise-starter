# ---------------------------------------------------------------------------
# Copy to .env and adjust. Defaults below match the Docker Compose stack, so
# `cp .env.example .env && pnpm docker:up` works with no edits.
#
# Every variable here is declared in src/config/env.schema.ts. CI fails if the
# two drift (`pnpm check:env`). Never commit real credentials.
# ---------------------------------------------------------------------------

# Runtime environment. One of: development | test | production
NODE_ENV=development

# Port the HTTP server binds to
PORT=3000

# Interface the HTTP server binds to. 0.0.0.0 is required inside containers.
HOST=0.0.0.0

# Minimum log level. One of: fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=debug

# PostgreSQL connection string. Host `postgres` resolves on the Compose network;
# use `localhost` when running the app outside Docker against the Compose database.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/nestjs_enterprise?schema=public

# Redis connection string. Host `redis` on the Compose network, `localhost` outside it.
REDIS_URL=redis://localhost:6379

# Per-dependency timeout (ms) for readiness checks
HEALTH_TIMEOUT_MS=2000


# ---------------------------------------------------------------------------
# Authentication
# ---------------------------------------------------------------------------

# Signs session cookies and tokens. No default in any environment.
# The value below is a PLACEHOLDER: it is long enough to boot locally, and is
# rejected outright when NODE_ENV=production. Generate your own with:
#   openssl rand -base64 32
BETTER_AUTH_SECRET=change-me-to-a-random-32-char-minimum-secret

# Public base URL of this service. Verification and password-reset links are
# built from it, and its scheme decides whether cookies are marked `Secure` and
# whether HSTS is sent — so set it to the real https:// URL in production.
APP_URL=http://localhost:3000

# Session lifetime, and how often an active session is refreshed (seconds)
SESSION_EXPIRES_IN_SECONDS=604800
SESSION_UPDATE_AGE_SECONDS=86400

# Password length bounds enforced at sign-up and reset
AUTH_MIN_PASSWORD_LENGTH=12
AUTH_MAX_PASSWORD_LENGTH=128

# Lifetime (seconds) of email-verification and password-reset tokens
AUTH_VERIFICATION_TOKEN_TTL_SECONDS=3600
AUTH_RESET_TOKEN_TTL_SECONDS=3600

# Name authenticator apps show next to the account
AUTH_TOTP_ISSUER=NestJS Enterprise Starter

# OAuth providers. Each is optional as a GROUP: leave both variables unset to
# disable the provider, or set both to enable it. Setting only one fails at boot.
# There is no separate enable flag — presence of the credentials is the switch.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
APPLE_CLIENT_ID=
APPLE_CLIENT_SECRET=


# ---------------------------------------------------------------------------
# Auth abuse resistance
# ---------------------------------------------------------------------------

# General limit for the auth surface: max requests per window (seconds)
AUTH_RATE_LIMIT_WINDOW_SECONDS=60
AUTH_RATE_LIMIT_MAX=60

# Tighter limit for credential paths (sign-in, sign-up, reset, 2FA verify).
# Boot fails unless this permits a strictly lower rate than the general limit.
AUTH_STRICT_RATE_LIMIT_WINDOW_SECONDS=300
AUTH_STRICT_RATE_LIMIT_MAX=10

# Per-account lockout: failures before backoff starts, the first delay, the
# ceiling on that delay, and how long the counter lives. The window expires on
# its own — there is no sticky lock and no admin unlock step, so an attacker
# cannot durably deny a real user their account.
AUTH_LOCKOUT_THRESHOLD=5
AUTH_LOCKOUT_BASE_DELAY_SECONDS=30
AUTH_LOCKOUT_MAX_DELAY_SECONDS=900
AUTH_LOCKOUT_WINDOW_SECONDS=3600


# ---------------------------------------------------------------------------
# Nest request throttling (application routes under /api/v1, not /api/auth/*)
# ---------------------------------------------------------------------------

# Short burst window and sustained per-minute window. Both must pass.
THROTTLE_BURST_WINDOW_SECONDS=10
THROTTLE_BURST_MAX=20
THROTTLE_MINUTE_WINDOW_SECONDS=60
THROTTLE_MINUTE_MAX=120

# Tighter ceilings for first-party account / session / 2FA Nest controllers.
# Boot fails unless these permit a lower rate than the defaults above.
THROTTLE_STRICT_BURST_WINDOW_SECONDS=10
THROTTLE_STRICT_BURST_MAX=10
THROTTLE_STRICT_MINUTE_WINDOW_SECONDS=60
THROTTLE_STRICT_MINUTE_MAX=30


# ---------------------------------------------------------------------------
# Daily / weekly usage ceilings (UTC calendar day and ISO week)
# ---------------------------------------------------------------------------

USAGE_LIMIT_DEFAULT_DAILY=1000
USAGE_LIMIT_DEFAULT_WEEKLY=5000
# Catalogue feature `demo` (fixture / examples). Override per feature as needed.
USAGE_LIMIT_DEMO_DAILY=100
USAGE_LIMIT_DEMO_WEEKLY=500


# ---------------------------------------------------------------------------
# Transport security
# ---------------------------------------------------------------------------

# Comma-separated browser origins allowed to make credentialed cross-origin
# requests. Also feeds the auth library's CSRF origin check, so there is one
# list rather than two that can drift. `*` is rejected: it is incompatible with
# credentialed CORS. Leave empty if no browser client calls this API.
CORS_ORIGINS=http://localhost:3000

# Whether to trust `X-Forwarded-For` for the client address. Leave false unless
# this service actually sits behind a proxy you control — trusting it otherwise
# lets any client forge its own rate-limit identity.
TRUST_PROXY=false


# ---------------------------------------------------------------------------
# Outbound mail
# ---------------------------------------------------------------------------

# `log` records messages to the log instead of sending them (development and
# tests). `smtp` delivers them. `log` is REJECTED when NODE_ENV=production,
# because it would make sign-up look successful while every verification and
# reset message silently vanished.
MAIL_TRANSPORT=log

# Envelope sender for outbound mail
MAIL_FROM=no-reply@localhost

# SMTP settings. Required as a group when MAIL_TRANSPORT=smtp; ignored for `log`.
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
SMTP_SECURE=false


# ---------------------------------------------------------------------------
# BullMQ job queues (share REDIS_URL; keys isolated by prefix)
# ---------------------------------------------------------------------------

BULLMQ_PREFIX=bull
BULLMQ_EMAIL_CONCURRENCY=5
BULLMQ_WEBHOOK_CONCURRENCY=5
BULLMQ_USAGE_ROLLUP_CONCURRENCY=1
BULLMQ_DEFAULT_ATTEMPTS=5
BULLMQ_BACKOFF_MS=2000
# When true, low-balance events enqueue mail on the email queue
EMAIL_LOW_BALANCE_ENABLED=false
# Usage rollup scheduler interval (ms). 0 disables automatic enqueue.
USAGE_ROLLUP_INTERVAL_MS=0


# ---------------------------------------------------------------------------
# Object storage
# ---------------------------------------------------------------------------

# `local` writes under STORAGE_LOCAL_ROOT (development/test). REJECTED when
# NODE_ENV=production — use `s3` with a complete credential group instead.
STORAGE_DRIVER=local
STORAGE_LOCAL_ROOT=./.storage
STORAGE_S3_BUCKET=
STORAGE_S3_REGION=
STORAGE_S3_ACCESS_KEY_ID=
STORAGE_S3_SECRET_ACCESS_KEY=
# Optional custom endpoint (MinIO, LocalStack). Leave blank for AWS.
STORAGE_S3_ENDPOINT=
STORAGE_S3_FORCE_PATH_STYLE=false


# ---------------------------------------------------------------------------
# Feature flags (env defaults; optional DB overrides win)
# ---------------------------------------------------------------------------

FEATURE_FLAG_EMAIL_LOW_BALANCE=false
FEATURE_FLAG_ORG_BILLING=true


# ---------------------------------------------------------------------------
# HTTP idempotency (opt-in POSTs via Idempotency-Key)
# ---------------------------------------------------------------------------

IDEMPOTENCY_TTL_SECONDS=86400
IDEMPOTENCY_KEY_MAX_LENGTH=128


# ---------------------------------------------------------------------------
# Graceful shutdown + organization binding
# ---------------------------------------------------------------------------

# How long to wait for in-flight BullMQ jobs on SIGTERM before forcing close
SHUTDOWN_DRAIN_MS=15000
# Header that binds organization context (membership is always verified)
ORGANIZATION_HEADER=x-organization-id


# ---------------------------------------------------------------------------
# Credits & Stripe top-up
# ---------------------------------------------------------------------------

# Optional: emit `credits.low_balance` after a spend that leaves the wallet at
# or below this value. Leave blank to disable the signal.
CREDITS_LOW_BALANCE_THRESHOLD=

# Stripe Checkout top-up. Optional as a GROUP: leave all three unset to disable
# paid top-up (the credit ledger and @CostsCredits still work). Setting only
# some of them fails at boot. Prefer a restricted key (rk_) over sk_ in real
# deployments. API version: 2026-07-29.dahlia (stripe Node SDK default).
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Packs as slug:credits:priceId, comma-separated. Example once you create Prices:
#   starter:100:price_xxx,boost:500:price_yyy
STRIPE_CREDIT_PACKS=
# Optional Checkout redirects; default to {APP_URL}/billing/success|cancel
STRIPE_SUCCESS_URL=
STRIPE_CANCEL_URL=


# ---------------------------------------------------------------------------
# Admin monitoring, metrics, OpenAPI
# ---------------------------------------------------------------------------

# Expose Prometheus text at GET /metrics. Off by default — enable only behind
# network isolation or a bearer token.
METRICS_ENABLED=false
# Optional scrape secret. When set, scrapers must send Authorization: Bearer …
METRICS_BEARER_TOKEN=
# Serve Swagger UI at /docs. Leave blank to default on in development, off
# otherwise. Set true/false to override.
SWAGGER_ENABLED=
# Default top-N for admin 429 leaderboards (max 100).
ADMIN_USAGE_TOP_N=20

# ---------------------------------------------------------------------------
# Nest-hosted MCP (Cursor / Claude / ChatGPT agents)
# ---------------------------------------------------------------------------
# Streamable HTTP MCP at MCP_PATH. Auth is Authorization: Bearer <api_key>
# (create keys via POST /api/v1/account/api-keys while signed in).
MCP_ENABLED=true
MCP_PATH=/mcp
MCP_THROTTLE_BURST_WINDOW_SECONDS=10
MCP_THROTTLE_BURST_MAX=30
MCP_THROTTLE_MINUTE_WINDOW_SECONDS=60
MCP_THROTTLE_MINUTE_MAX=120
