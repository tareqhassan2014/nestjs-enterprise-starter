# ---------------------------------------------------------------------------
# Copy to .env and adjust. Defaults below match the Docker Compose stack, so
# `cp .env.example .env && pnpm docker:up` works with no edits.
#
# Every variable here is declared in src/config/env.schema.ts. CI fails if the
# two drift (`pnpm check:env`). Never commit real credentials.
# ---------------------------------------------------------------------------

# Runtime environment. One of: development | test | production
NODE_ENV=development

# Port the HTTP server binds to
PORT=3000

# Interface the HTTP server binds to. 0.0.0.0 is required inside containers.
HOST=0.0.0.0

# Minimum log level. One of: fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=debug

# PostgreSQL connection string. Host `postgres` resolves on the Compose network;
# use `localhost` when running the app outside Docker against the Compose database.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/nestjs_enterprise?schema=public

# Redis connection string. Host `redis` on the Compose network, `localhost` outside it.
REDIS_URL=redis://localhost:6379

# Per-dependency timeout (ms) for readiness checks
HEALTH_TIMEOUT_MS=2000
