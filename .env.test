# Committed on purpose: holds no secrets, and lets `pnpm test` run on a fresh
# clone with no setup. Integration tests point at the Docker Compose services.
NODE_ENV=test
PORT=3001
HOST=127.0.0.1

# Tests assert on log content through the logger directly, not stdout.
LOG_LEVEL=silent

DATABASE_URL=postgresql://postgres:postgres@localhost:5432/nestjs_enterprise_test?schema=public
REDIS_URL=redis://localhost:6379

HEALTH_TIMEOUT_MS=2000

# Auth. A fixed non-secret value: tests need a stable signing key, and this file
# is committed, so it must never hold anything real.
BETTER_AUTH_SECRET=test-only-secret-not-used-outside-the-test-suite
APP_URL=http://127.0.0.1:3001

# Mail is recorded in memory so the suite needs no SMTP server.
MAIL_TRANSPORT=log
MAIL_FROM=no-reply@test.local

# Deliberately generous. Every functional suite signs in repeatedly from one
# address, so production-shaped limits would throttle tests that are not about
# throttling — and the failure would look like broken auth. The limiting and
# lockout behaviour is exercised in test/auth-rate-limiting.e2e-spec.ts, which
# builds an app with its own tight values.
#
# The strict rate must still be lower than the general one, or boot fails.
AUTH_RATE_LIMIT_WINDOW_SECONDS=60
AUTH_RATE_LIMIT_MAX=2000
AUTH_STRICT_RATE_LIMIT_WINDOW_SECONDS=60
AUTH_STRICT_RATE_LIMIT_MAX=1000

AUTH_LOCKOUT_THRESHOLD=50
AUTH_LOCKOUT_WINDOW_SECONDS=60

# Nest throttling: deliberately generous so functional suites are not blocked.
# Behaviour is covered by test/request-throttling.e2e-spec.ts with tight overrides.
THROTTLE_BURST_WINDOW_SECONDS=10
THROTTLE_BURST_MAX=10000
THROTTLE_MINUTE_WINDOW_SECONDS=60
THROTTLE_MINUTE_MAX=100000
THROTTLE_STRICT_BURST_WINDOW_SECONDS=10
THROTTLE_STRICT_BURST_MAX=5000
THROTTLE_STRICT_MINUTE_WINDOW_SECONDS=60
THROTTLE_STRICT_MINUTE_MAX=50000

USAGE_LIMIT_DEFAULT_DAILY=100000
USAGE_LIMIT_DEFAULT_WEEKLY=500000
USAGE_LIMIT_DEMO_DAILY=100000
USAGE_LIMIT_DEMO_WEEKLY=500000

CORS_ORIGINS=http://localhost:3000
TRUST_PROXY=false
