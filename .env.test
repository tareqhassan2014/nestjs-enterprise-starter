# Committed on purpose: holds no secrets, and lets `pnpm test` run on a fresh
# clone with no setup. Integration tests point at the Docker Compose services.
NODE_ENV=test
PORT=3001
HOST=127.0.0.1

# Tests assert on log content through the logger directly, not stdout.
LOG_LEVEL=silent

DATABASE_URL=postgresql://postgres:postgres@localhost:5432/nestjs_enterprise_test?schema=public
REDIS_URL=redis://localhost:6379

HEALTH_TIMEOUT_MS=2000
