// Prisma 7. Written by hand rather than via `prisma init`, which also
// scaffolds agent-skill directories into the repo root.
//
// The client is generated into src/ so `nest build` compiles it into dist/ —
// output anywhere else would be missing at runtime. See design.md decision 8.

generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "cjs"
  runtime             = "nodejs"
  importFileExtension = ""
}

// The connection string is supplied by prisma.config.ts for CLI commands, and
// by the validated `database` config namespace at runtime — never read from
// process.env by Prisma itself.
datasource db {
  provider = "postgresql"
}

/// Runtime settings and feature flags.
///
/// Kept deliberately unrelated to identity, so the seed hook and the
/// persistence round-trip test exercise a real write/read cycle independently of
/// authentication.
model AppSetting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt

  @@map("app_settings")
}

// ---------------------------------------------------------------------------
// Identity — owned by Better Auth
//
// Hand-written rather than produced by `@better-auth/cli generate`, which
// rewrites this file and would drop these comments. The field list was taken
// from `getAuthTables()` in the installed better-auth (1.6.25) — the same
// definitions its Prisma adapter reads — not from documentation.
//
// The MODEL names must stay as they are: the adapter reaches these tables as
// `prisma.user`, `prisma.session`, `prisma.account`, `prisma.verification`, and
// `prisma.twoFactor`. Table names are @@map-ed to snake_case to match
// `app_settings`; columns keep their camelCase names, as in the baseline model.
//
// Renaming a field here without telling Better Auth (via its `fields` option)
// breaks it silently, so don't.
// ---------------------------------------------------------------------------

model User {
  id            String  @id @default(cuid())
  name          String
  email         String  @unique
  emailVerified Boolean @default(false)
  image         String?

  /// Maintained by the twoFactor plugin; the enrolled secret lives in TwoFactor.
  twoFactorEnabled Boolean? @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  accounts      Account[]
  sessions      Session[]
  twoFactor     TwoFactor[]
  roles         UserRole[]
  subscriptions Subscription[]
  creditWallet  CreditWallet?
  creditLedger  CreditLedgerEntry[]
  stripeCustomer StripeCustomer?
  adminAuditLogs AdminAuditLog[] @relation("AdminAuditActor")

  @@map("users")
}

/// A session is a row, not a signed claim — which is what makes revocation
/// immediate. Redis caches these (see design.md decision 3); this table stays
/// authoritative, so a cache miss falls through to here rather than logging
/// everyone out.
model Session {
  id        String   @id @default(cuid())
  expiresAt DateTime
  token     String   @unique
  ipAddress String?
  userAgent String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

/// One row per credential: the password row for email/password sign-in, plus a
/// row per linked OAuth provider.
model Account {
  id         String @id @default(cuid())
  accountId  String
  providerId String

  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?

  /// Scrypt hash for the credentials provider; null for OAuth accounts.
  password String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([providerId, accountId])
  @@index([userId])
  @@map("accounts")
}

/// Short-lived, single-use tokens: email verification and password reset.
model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([identifier])
  @@map("verifications")
}

/// TOTP enrolment and backup codes. `backupCodes` is a single encrypted blob
/// managed by the plugin — never plaintext, and never read by our code.
model TwoFactor {
  id          String  @id @default(cuid())
  secret      String
  backupCodes String
  verified    Boolean? @default(false)

  /// The plugin's own 2FA attempt throttling, separate from our sign-in lockout.
  failedVerificationCount Int?      @default(0)
  lockedUntil             DateTime?

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("two_factors")
}

// ---------------------------------------------------------------------------
// Access control — ours
//
// Assignments and mappings are data, editable at runtime. The *vocabulary* of
// permission keys is code (src/modules/authorization/permissions.ts) and is
// seeded from there, so a decorator cannot name a permission that does not
// exist and an operator cannot invent one that no guard consults.
// ---------------------------------------------------------------------------

model Role {
  id          String  @id @default(cuid())
  name        String  @unique
  description String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  permissions RolePermission[]
  users       UserRole[]

  @@map("roles")
}

/// One row per permission key declared in code, e.g. `user:read`.
model Permission {
  id          String  @id @default(cuid())
  key         String  @unique
  description String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  roles RolePermission[]

  @@map("permissions")
}

/// The composite unique is what makes seeding idempotent — the database
/// prevents duplicates, rather than the seed script remembering to check.
model RolePermission {
  id String @id @default(cuid())

  roleId       String
  permissionId String

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([roleId, permissionId])
  @@index([roleId])
  @@index([permissionId])
  @@map("role_permissions")
}

/// A user may hold several roles; effective permissions are the union.
model UserRole {
  id String @id @default(cuid())

  userId String
  roleId String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([userId, roleId])
  @@index([userId])
  @@index([roleId])
  @@map("user_roles")
}

// ---------------------------------------------------------------------------
// Plans & subscriptions — commercial packaging
//
// The *vocabulary* of entitlement keys lives in code
// (`src/modules/plans/entitlements.ts`). Values and usage ceilings live here so
// operators can tune matrices without a deploy of every fork; Stripe binds
// later via nullable external ids, not by inventing parallel plan tables.
// ---------------------------------------------------------------------------

enum BillingInterval {
  monthly
  yearly
}

enum SubscriptionStatus {
  active
  past_due
  canceled
}

/// Commercial tier. Slug is stable (`lite` / `pro` / `enterprise`); rank drives
/// `@RequirePlan` minimum checks.
model Plan {
  id          String  @id @default(cuid())
  slug        String  @unique
  name        String
  description String?
  /// Ordering for minimum-plan gates. Lite < Pro < Enterprise.
  rank        Int
  isActive    Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  entitlements PlanEntitlement[]
  usageLimits  PlanUsageLimit[]
  subscriptions Subscription[]

  @@map("plans")
}

/// Boolean feature flag per plan. Unique on (plan, key) makes seed idempotent.
model PlanEntitlement {
  id String @id @default(cuid())

  planId         String
  entitlementKey String
  enabled        Boolean @default(false)

  plan Plan @relation(fields: [planId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([planId, entitlementKey])
  @@index([entitlementKey])
  @@map("plan_entitlements")
}

/// Daily/weekly usage ceilings for a catalogue usage feature on a plan.
model PlanUsageLimit {
  id String @id @default(cuid())

  planId      String
  /// Matches `USAGE_FEATURES` catalogue strings (e.g. `demo`).
  feature     String
  dailyLimit  Int
  weeklyLimit Int

  plan Plan @relation(fields: [planId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([planId, feature])
  @@index([feature])
  @@map("plan_usage_limits")
}

/// User↔plan binding with billing interval and lifecycle status.
model Subscription {
  id String @id @default(cuid())

  userId String
  planId String

  interval BillingInterval
  status   SubscriptionStatus

  currentPeriodStart DateTime?
  currentPeriodEnd   DateTime?
  canceledAt         DateTime?

  /// Forward-compat for Stripe; unused until billing lands.
  stripeCustomerId     String?
  stripeSubscriptionId String?
  stripePriceId        String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan Plan @relation(fields: [planId], references: [id], onDelete: Restrict)

  @@index([userId])
  @@index([planId])
  @@index([status])
  @@map("subscriptions")
}

// ---------------------------------------------------------------------------
// Credits & Stripe top-up — pay-as-you-go wallet + Checkout ingress
//
// Balance lives on CreditWallet; every mutation appends CreditLedgerEntry with
// a unique idempotency key. Stripe Checkout grants credits; it does not drive
// subscription lifecycle (see Subscription above).
// ---------------------------------------------------------------------------

enum CreditLedgerType {
  grant
  spend
  refund
  adjust
}

/// Cached balance per user. Created lazily on the first credit mutation.
model CreditWallet {
  userId  String @id
  balance Int    @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("credit_wallets")
}

/// Append-only credit movement. `amount` is always positive; `type` is direction.
model CreditLedgerEntry {
  id String @id @default(cuid())

  userId String
  type   CreditLedgerType
  /// Absolute credits moved; never negative.
  amount Int
  balanceAfter Int
  /// Catalogue feature for spends (e.g. `demo.paid`); null for grants/adjusts.
  feature String?
  idempotencyKey String @unique
  metadata Json?

  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@map("credit_ledger_entries")
}

/// Nest user ↔ Stripe Customer for Checkout top-up.
model StripeCustomer {
  userId           String @id
  stripeCustomerId String @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("stripe_customers")
}

/// Webhook at-least-once dedupe by Stripe event id.
model StripeProcessedEvent {
  eventId     String   @id
  type        String
  processedAt DateTime @default(now())

  @@map("stripe_processed_events")
}

// ---------------------------------------------------------------------------
// Admin audit — append-only privileged mutation trail
// ---------------------------------------------------------------------------

/// Operator action record. Application APIs never update or delete rows.
model AdminAuditLog {
  id String @id @default(cuid())

  actorUserId String
  action      String
  targetType  String?
  targetId    String?
  summary     String
  metadata    Json?
  requestId   String?

  createdAt DateTime @default(now())

  actor User @relation("AdminAuditActor", fields: [actorUserId], references: [id], onDelete: Cascade)

  @@index([actorUserId, createdAt])
  @@index([action, createdAt])
  @@index([targetType, targetId, createdAt])
  @@map("admin_audit_log")
}
