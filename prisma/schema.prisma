// Prisma 7. Written by hand rather than via `prisma init`, which also
// scaffolds agent-skill directories into the repo root.
//
// The client is generated into src/ so `nest build` compiles it into dist/ —
// output anywhere else would be missing at runtime. See design.md decision 8.

generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "cjs"
  runtime             = "nodejs"
  importFileExtension = ""
}

// The connection string is supplied by prisma.config.ts for CLI commands, and
// by the validated `database` config namespace at runtime — never read from
// process.env by Prisma itself.
datasource db {
  provider = "postgresql"
}

/// Runtime settings and feature flags.
///
/// Kept deliberately unrelated to identity, so the seed hook and the
/// persistence round-trip test exercise a real write/read cycle independently of
/// authentication.
model AppSetting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt

  @@map("app_settings")
}

// ---------------------------------------------------------------------------
// Identity — owned by Better Auth
//
// Hand-written rather than produced by `@better-auth/cli generate`, which
// rewrites this file and would drop these comments. The field list was taken
// from `getAuthTables()` in the installed better-auth (1.6.25) — the same
// definitions its Prisma adapter reads — not from documentation.
//
// The MODEL names must stay as they are: the adapter reaches these tables as
// `prisma.user`, `prisma.session`, `prisma.account`, `prisma.verification`, and
// `prisma.twoFactor`. Table names are @@map-ed to snake_case to match
// `app_settings`; columns keep their camelCase names, as in the baseline model.
//
// Renaming a field here without telling Better Auth (via its `fields` option)
// breaks it silently, so don't.
// ---------------------------------------------------------------------------

model User {
  id            String  @id @default(cuid())
  name          String
  email         String  @unique
  emailVerified Boolean @default(false)
  image         String?

  /// Maintained by the twoFactor plugin; the enrolled secret lives in TwoFactor.
  twoFactorEnabled Boolean? @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  accounts      Account[]
  sessions      Session[]
  twoFactor     TwoFactor[]
  roles         UserRole[]
  subscriptions Subscription[]
  creditWallet  CreditWallet?
  creditLedger  CreditLedgerEntry[]
  stripeCustomer StripeCustomer?
  adminAuditLogs AdminAuditLog[] @relation("AdminAuditActor")
  apiKeys        ApiKey[]
  mcpInvocations McpToolInvocation[]
  organizationMemberships OrganizationMember[]

  @@map("users")
}

/// A session is a row, not a signed claim — which is what makes revocation
/// immediate. Redis caches these (see design.md decision 3); this table stays
/// authoritative, so a cache miss falls through to here rather than logging
/// everyone out.
model Session {
  id        String   @id @default(cuid())
  expiresAt DateTime
  token     String   @unique
  ipAddress String?
  userAgent String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

/// One row per credential: the password row for email/password sign-in, plus a
/// row per linked OAuth provider.
model Account {
  id         String @id @default(cuid())
  accountId  String
  providerId String

  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?

  /// Scrypt hash for the credentials provider; null for OAuth accounts.
  password String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([providerId, accountId])
  @@index([userId])
  @@map("accounts")
}

/// Short-lived, single-use tokens: email verification and password reset.
model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([identifier])
  @@map("verifications")
}

/// TOTP enrolment and backup codes. `backupCodes` is a single encrypted blob
/// managed by the plugin — never plaintext, and never read by our code.
model TwoFactor {
  id          String  @id @default(cuid())
  secret      String
  backupCodes String
  verified    Boolean? @default(false)

  /// The plugin's own 2FA attempt throttling, separate from our sign-in lockout.
  failedVerificationCount Int?      @default(0)
  lockedUntil             DateTime?

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("two_factors")
}

// ---------------------------------------------------------------------------
// Access control — ours
//
// Assignments and mappings are data, editable at runtime. The *vocabulary* of
// permission keys is code (src/modules/authorization/permissions.ts) and is
// seeded from there, so a decorator cannot name a permission that does not
// exist and an operator cannot invent one that no guard consults.
// ---------------------------------------------------------------------------

model Role {
  id          String  @id @default(cuid())
  name        String  @unique
  description String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  permissions RolePermission[]
  users       UserRole[]

  @@map("roles")
}

/// One row per permission key declared in code, e.g. `user:read`.
model Permission {
  id          String  @id @default(cuid())
  key         String  @unique
  description String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  roles RolePermission[]

  @@map("permissions")
}

/// The composite unique is what makes seeding idempotent — the database
/// prevents duplicates, rather than the seed script remembering to check.
model RolePermission {
  id String @id @default(cuid())

  roleId       String
  permissionId String

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([roleId, permissionId])
  @@index([roleId])
  @@index([permissionId])
  @@map("role_permissions")
}

/// A user may hold several roles; effective permissions are the union.
model UserRole {
  id String @id @default(cuid())

  userId String
  roleId String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([userId, roleId])
  @@index([userId])
  @@index([roleId])
  @@map("user_roles")
}

// ---------------------------------------------------------------------------
// Plans & subscriptions — commercial packaging
//
// The *vocabulary* of entitlement keys lives in code
// (`src/modules/plans/entitlements.ts`). Values and usage ceilings live here so
// operators can tune matrices without a deploy of every fork; Stripe binds
// later via nullable external ids, not by inventing parallel plan tables.
// ---------------------------------------------------------------------------

enum BillingInterval {
  monthly
  yearly
}

enum SubscriptionStatus {
  active
  past_due
  canceled
}

/// Commercial tier. Slug is stable (`lite` / `pro` / `enterprise`); rank drives
/// `@RequirePlan` minimum checks.
model Plan {
  id          String  @id @default(cuid())
  slug        String  @unique
  name        String
  description String?
  /// Ordering for minimum-plan gates. Lite < Pro < Enterprise.
  rank        Int
  isActive    Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  entitlements PlanEntitlement[]
  usageLimits  PlanUsageLimit[]
  subscriptions Subscription[]

  @@map("plans")
}

/// Boolean feature flag per plan. Unique on (plan, key) makes seed idempotent.
model PlanEntitlement {
  id String @id @default(cuid())

  planId         String
  entitlementKey String
  enabled        Boolean @default(false)

  plan Plan @relation(fields: [planId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([planId, entitlementKey])
  @@index([entitlementKey])
  @@map("plan_entitlements")
}

/// Daily/weekly usage ceilings for a catalogue usage feature on a plan.
model PlanUsageLimit {
  id String @id @default(cuid())

  planId      String
  /// Matches `USAGE_FEATURES` catalogue strings (e.g. `demo`).
  feature     String
  dailyLimit  Int
  weeklyLimit Int

  plan Plan @relation(fields: [planId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([planId, feature])
  @@index([feature])
  @@map("plan_usage_limits")
}

/// User↔plan binding with billing interval and lifecycle status.
///
/// Owned by exactly one of `userId` / `organizationId` (never both, never
/// neither) — enforced by a check constraint added in the
/// `async_cross_cutting` migration, not by Prisma. Organization-owned rows are
/// additive: user-primary subscriptions are unaffected. See `BillingSubject`
/// and design.md decision 4.
model Subscription {
  id String @id @default(cuid())

  userId         String?
  organizationId String?
  planId         String

  interval BillingInterval
  status   SubscriptionStatus

  currentPeriodStart DateTime?
  currentPeriodEnd   DateTime?
  canceledAt         DateTime?

  /// Forward-compat for Stripe; unused until billing lands.
  stripeCustomerId     String?
  stripeSubscriptionId String?
  stripePriceId        String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user         User?         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  plan         Plan          @relation(fields: [planId], references: [id], onDelete: Restrict)

  @@index([userId])
  @@index([organizationId])
  @@index([planId])
  @@index([status])
  @@map("subscriptions")
}

// ---------------------------------------------------------------------------
// Credits & Stripe top-up — pay-as-you-go wallet + Checkout ingress
//
// Balance lives on CreditWallet; every mutation appends CreditLedgerEntry with
// a unique idempotency key. Stripe Checkout grants credits; it does not drive
// subscription lifecycle (see Subscription above).
// ---------------------------------------------------------------------------

enum CreditLedgerType {
  grant
  spend
  refund
  adjust
}

/// Cached balance per wallet owner. Created lazily on the first credit
/// mutation, and owned by exactly one of `userId` / `organizationId` — never
/// both, never neither. Enforced by a check constraint added in the
/// `async_cross_cutting` migration (Prisma has no native XOR constraint); see
/// `BillingSubject` and design.md decision 4.
///
/// `id` exists so the row has a stable primary key independent of which owner
/// column is populated — `userId` alone can no longer be `@id` once it is
/// nullable.
model CreditWallet {
  id             String  @id @default(cuid())
  userId         String? @unique
  organizationId String? @unique
  balance        Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user         User?         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@map("credit_wallets")
}

/// Append-only credit movement. `amount` is always positive; `type` is
/// direction. Owned by exactly one of `userId` / `organizationId`, mirroring
/// the wallet it moves — see `CreditWallet`.
model CreditLedgerEntry {
  id String @id @default(cuid())

  userId         String?
  organizationId String?
  type           CreditLedgerType
  /// Absolute credits moved; never negative.
  amount Int
  balanceAfter Int
  /// Catalogue feature for spends (e.g. `demo.paid`); null for grants/adjusts.
  feature String?
  idempotencyKey String @unique
  metadata Json?

  createdAt DateTime @default(now())

  user         User?         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([organizationId, createdAt])
  @@map("credit_ledger_entries")
}

/// Nest user ↔ Stripe Customer for Checkout top-up.
model StripeCustomer {
  userId           String @id
  stripeCustomerId String @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("stripe_customers")
}

/// Webhook at-least-once dedupe by Stripe event id.
model StripeProcessedEvent {
  eventId     String   @id
  type        String
  processedAt DateTime @default(now())

  @@map("stripe_processed_events")
}

// ---------------------------------------------------------------------------
// Admin audit — append-only privileged mutation trail
// ---------------------------------------------------------------------------

/// Operator action record. Application APIs never update or delete rows.
model AdminAuditLog {
  id String @id @default(cuid())

  actorUserId String
  action      String
  targetType  String?
  targetId    String?
  summary     String
  metadata    Json?
  requestId   String?

  createdAt DateTime @default(now())

  actor User @relation("AdminAuditActor", fields: [actorUserId], references: [id], onDelete: Cascade)

  @@index([actorUserId, createdAt])
  @@index([action, createdAt])
  @@index([targetType, targetId, createdAt])
  @@map("admin_audit_log")
}

// ---------------------------------------------------------------------------
// Agent API keys + MCP tool invocation audit
// ---------------------------------------------------------------------------

/// User-scoped agent credential. Plaintext is shown once at create; only the
/// hash is stored. Prefix enables lookup before constant-time hash compare.
model ApiKey {
  id String @id @default(cuid())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// Operator-facing label (e.g. "Cursor laptop").
  name String

  /// Public lookup fragment of the secret (e.g. first 12 chars of `nes_…`).
  prefix     String
  secretHash String

  lastUsedAt DateTime?
  revokedAt  DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  invocations McpToolInvocation[]

  @@unique([prefix])
  @@index([userId])
  @@index([userId, revokedAt])
  @@map("api_keys")
}

/// Append-only MCP tool call trail (success / denied / error after auth).
model McpToolInvocation {
  id String @id @default(cuid())

  userId   String
  apiKeyId String
  toolName String
  /// success | denied | error
  outcome   String
  errorCode String?
  requestId String?

  createdAt DateTime @default(now())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  apiKey ApiKey @relation(fields: [apiKeyId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([apiKeyId, createdAt])
  @@index([toolName, createdAt])
  @@map("mcp_tool_invocations")
}

// ---------------------------------------------------------------------------
// Organizations — minimal membership + billing-subject hooks
//
// Not a tenancy product: no invitations, no SSO-per-org, no branding. Just
// enough for `BillingSubjectResolver` to prefer an org wallet/subscription
// over the calling user's when a request binds one and membership checks out.
// See `src/modules/organizations/billing-subject.ts` and design.md decision 4.
// ---------------------------------------------------------------------------

enum OrganizationBillingMode {
  user
  organization
}

enum OrganizationMemberRole {
  owner
  admin
  member
}

/// A billing-capable group of users. `billingMode` is the per-org kill switch:
/// `user` (default) means members keep spending their own wallets even while
/// bound to this org; `organization` means the org wallet/subscription is
/// preferred once `FEATURE_FLAG_ORG_BILLING` also allows it.
model Organization {
  id          String                  @id @default(cuid())
  slug        String                  @unique
  name        String
  billingMode OrganizationBillingMode @default(user)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  members       OrganizationMember[]
  subscriptions Subscription[]
  creditWallet  CreditWallet?
  creditLedger  CreditLedgerEntry[]
  flagOverrides FeatureFlagOverride[]

  @@map("organizations")
}

/// One row per user↔organization pairing. The composite unique is what makes
/// membership checks (and re-adding an existing member) idempotent.
model OrganizationMember {
  id String @id @default(cuid())

  organizationId String
  userId         String
  role           OrganizationMemberRole @default(member)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId])
  @@index([userId])
  @@map("organization_members")
}

// ---------------------------------------------------------------------------
// Feature flags — optional persisted overrides
//
// The flag *vocabulary* is code (src/modules/feature-flags/feature-flags.catalogue.ts).
// A row here overrides the env default for one user or one organization;
// global overrides (both null) apply to everyone. Resolution order lives in
// FeatureFlagsService: user override → org override → env default → code
// default. See design.md decision 3.
// ---------------------------------------------------------------------------

model FeatureFlagOverride {
  id String @id @default(cuid())

  flagKey        String
  enabled        Boolean
  userId         String?
  organizationId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  /// Partial uniqueness (one global row, one row per user, one row per org
  /// per flag) is enforced by conditional unique indexes in the migration,
  /// since a plain `@@unique` cannot treat two NULLs as distinct rows here.
  @@index([flagKey])
  @@index([userId])
  @@index([organizationId])
  @@map("feature_flag_overrides")
}

// ---------------------------------------------------------------------------
// HTTP idempotency — opt-in POSTs via `Idempotency-Key`
//
// One row per (principal, key). First request processes normally and stores
// the outcome; a replay with the same key + request hash returns it unrun.
// Same key + different hash is a conflict (`IDEMPOTENCY_KEY_REUSE`). Rows
// expire via `expiresAt`; nothing here is read by BullMQ. See design.md
// decision 5 and the `request-idempotency` capability.
// ---------------------------------------------------------------------------

enum IdempotencyRecordStatus {
  processing
  completed
}

model IdempotencyRecord {
  id String @id @default(cuid())

  /// Caller identity the key is scoped to — a userId or apiKeyId today.
  principalId String
  key         String
  method      String
  path        String
  /// Hash of method + path + body, so the same key with a different payload
  /// is a conflict rather than a silent replay of the wrong response.
  requestHash String
  status      IdempotencyRecordStatus @default(processing)
  statusCode  Int?
  responseBody Json?

  expiresAt DateTime
  createdAt DateTime @default(now())

  @@unique([principalId, key])
  @@index([expiresAt])
  @@map("idempotency_records")
}
